 #define ISH_INTERNAL
 #include "fs/fake.h"
 
+/*
+ * Portability shims for the macOS-flavoured bind-mount code below.
+ * Linux/OHOS exposes the same timestamps under st_*tim, and there is no
+ * F_GETPATH ioctl, but /proc/self/fd works as a replacement.
+ */
+#if !defined(__APPLE__)
+#  define st_atimespec st_atim
+#  define st_mtimespec st_mtim
+#  define st_ctimespec st_ctim
+
+static int host_fd_path(int fd, char *buffer, size_t size) {
+    char link[64];
+    snprintf(link, sizeof(link), "/proc/self/fd/%d", fd);
+    ssize_t length = readlink(link, buffer, size - 1);
+    if (length < 0) {
+        return -1;
+    }
+    buffer[length] = '\0';
+    return 0;
+}
+#else
+static int host_fd_path(int fd, char *buffer, size_t size) {
+    (void)size;
+    return fcntl(fd, F_GETPATH, buffer);
+}
+#endif
+
